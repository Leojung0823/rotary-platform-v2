{
  "name": "rotary-platform-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap:superadmin": "node scripts/bootstrap-superadmin.mjs",
    "verify:db": "bash scripts/verify-local-database.sh",
    "verify:auth": "node scripts/verify-local-auth-flow.mjs",
    "check:migrations": "bash scripts/check-migration-history.sh",
    "db:v12:start": "bash database/v12/scripts/start.sh",
    "db:v12:stop": "bash database/v12/scripts/stop.sh",
    "db:v12:reset": "bash database/v12/scripts/reset.sh",
    "db:v12:seed": "bash database/v12/scripts/seed.sh",
    "db:v12:seed:verify": "bash database/v12/scripts/seed-verify.sh",
    "db:v12:test": "bash database/v12/scripts/test.sh",
    "db:v12:invitation:edge:test": "vitest run database/v12/supabase/functions/_shared/invitation-token.test.ts database/v12/supabase/functions/_shared/invitation-edge.test.ts",
    "db:v12:invitation:create-concurrency:test": "bash database/v12/scripts/invitation-create-concurrency-test.sh",
    "db:v12:invitation:rpc-boundary:test": "bash database/v12/scripts/invitation-rpc-boundary-test.sh",
    "db:v12:invitation:constraints:test": "bash database/v12/scripts/invitation-constraint-test.sh",
    "db:v12:invitation:recovery:test": "bash database/v12/scripts/invitation-edge-recovery-test.sh",
    "db:v12:decisions:test": "bash database/v12/scripts/decision-contract-test.sh",
    "db:v12:security:scan": "bash database/v12/scripts/security-scan.sh",
    "db:v12:lint": "bash database/v12/scripts/lint.sh",
    "db:v12:migrations:verify": "bash database/v12/scripts/verify-migrations.sh",
    "db:v12:migration:new": "bash database/v12/scripts/new-migration.sh",
    "db:v12:types": "bash database/v12/scripts/types.sh",
    "db:v12:types:check": "bash database/v12/scripts/types-check.sh",
    "db:v12:verify": "bash database/v12/scripts/verify.sh"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "exceljs": "^4.4.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.10",
      "sharp": "0.35.3"
    }
  }
}
