NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=
VERIFY_OPERATOR_PASSWORD=
NEXT_PUBLIC_SITE_URL=
APP_ENV=
TRUSTED_ADMIN_ENVIRONMENT=

# LINE Login provider selection. Use `mock` only for local/test; production
# must use `line` and fails closed when real provider configuration is absent.
LINE_LOGIN_MODE=
# LINE Login values below are read only by server code. Never add
# `NEXT_PUBLIC_` to channel secret or mock signing secret names.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=
# Existing repository name retained for the local/test-only signing key.
# Use at least 32 random characters and never reuse a Supabase or LINE secret.
LINE_MOCK_SIGNING_SECRET=

LINE_OA_MODE=
LINE_OA_CHANNEL_SECRET=
LINE_OA_CHANNEL_ACCESS_TOKEN=
