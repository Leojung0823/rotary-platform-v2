# Supabase public connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never expose this value to browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Protected staging workflow inputs. Names are documented here; never commit values.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
STAGING_EXPECTED_CLUB_NAME=
STAGING_TEST_MEMBER_EMAIL=
STAGING_TEST_MEMBER_PASSWORD=
# Initial provisioning is opt-in and requires the exact confirmation documented in STAGING_RUNBOOK.md.
STAGING_PROVISION_TEST_DATA=
STAGING_PROVISIONING_CONFIRMATION=
STAGING_BACKUP_CONFIRMATION=
# Required production inventory used to prove the target is not production.
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REFS=
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_URLS=

# Local bootstrap and local vertical verification
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=
VERIFY_OPERATOR_PASSWORD=
# Hosted bootstrap is staging-only. Set this to the exact Supabase hostname for one explicit run.
# Production bootstrap is always rejected.
BOOTSTRAP_CONFIRM_SUPABASE_HOST=

# Runtime identity
# APP_ENV must be local, staging, or production.
NEXT_PUBLIC_SITE_URL=
APP_ENV=
# Render supplies this public HTTPS origin automatically at build and runtime.
# Leave it unset outside Render; server-side redirects use it as a hosted fallback.
RENDER_EXTERNAL_URL=
# Leave blank locally. For hosted environments it must exactly match APP_ENV.
TRUSTED_ADMIN_ENVIRONMENT=

# Emergency rollout kill switches. Set only the exact value true to disable a new experience.
# These variables can force a safe legacy fallback, but they cannot enable a database-disabled feature.
FORCE_LEGACY_ROLE_SHELLS=false
FORCE_LEGACY_MEMBER_HOME=false
DISABLE_GPS_CHECKIN=false

# LINE Login
# mock is local-only. Hosted staging and production must use line.
LINE_LOGIN_MODE=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Required for line mode and must equal:
# <NEXT_PUBLIC_SITE_URL>/api/auth/line/callback
LINE_LOGIN_CALLBACK_URL=
# Local mock only; use at least 32 random characters.
LINE_MOCK_SIGNING_SECRET=

# LINE Official Account
# staging may remain mock with a warning; production must use line.
LINE_OA_MODE=
# Configure one secret/token pair per club code. Hyphens and other symbols become underscores.
# Example for club code TAIPEI-NORTH:
# LINE_OA_TAIPEI_NORTH_CHANNEL_SECRET=
# LINE_OA_TAIPEI_NORTH_CHANNEL_ACCESS_TOKEN=
