# line_oa_accounts record and configure both variables using its 24 hex chars.
# Do not restore a global fallback token or secret.
# LINE_OA_ACCOUNT_<CREDENTIAL_REF>_CHANNEL_SECRET=
# LINE_OA_ACCOUNT_<CREDENTIAL_REF>_ACCESS_TOKEN=
