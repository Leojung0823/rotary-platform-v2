# Supabase public connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never expose this value to browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Local bootstrap and local vertical verification only
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=
VERIFY_OPERATOR_PASSWORD=

# Runtime identity
# APP_ENV must be local, staging, or production.
NEXT_PUBLIC_SITE_URL=
APP_ENV=
# Leave blank locally. For hosted environments it must exactly match APP_ENV.
TRUSTED_ADMIN_ENVIRONMENT=

# LINE Login
# mock is local-only. Hosted staging and production must use line.
LINE_LOGIN_MODE=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Required for line mode and must equal:
# <NEXT_PUBLIC_SITE_URL>/api/auth/line/callback
LINE_LOGIN_CALLBACK_URL=
# Local mock only; use at least 32 random characters.
LINE_MOCK_SIGNING_SECRET=

# LINE Official Account
# staging may remain mock with a warning; production must use line.
LINE_OA_MODE=
# Configure one secret/token pair per club code. Hyphens and other symbols become underscores.
# Example for club code TAIPEI-NORTH:
# LINE_OA_TAIPEI_NORTH_CHANNEL_SECRET=
# LINE_OA_TAIPEI_NORTH_CHANNEL_ACCESS_TOKEN=
