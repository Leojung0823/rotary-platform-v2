# Copy to .env.staging (git-ignored) to run staging-targeting scripts.
#
# Everything here is non-secret: the URL and publishable key are values the
# browser already receives, and the two confirmations exist so a staging script
# cannot be pointed at production by accident.
#
# Do NOT put PLATFORM_ADMIN_PASSWORD here. Leave it out and the script asks for
# it on the terminal with the input hidden, so it never lands in this file, in
# your shell history, or in the process list.

NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<staging publishable / anon key>
PLATFORM_ADMIN_EMAIL=<the staging platform admin account>

APP_ENV=staging
TRUSTED_ADMIN_ENVIRONMENT=staging
# Must equal the hostname in NEXT_PUBLIC_SUPABASE_URL. Stating it twice is the
# point: it is what stops a script aimed at staging from touching anything else.
BOOTSTRAP_CONFIRM_SUPABASE_HOST=<staging-project-ref>.supabase.co
