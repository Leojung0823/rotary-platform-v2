{
  "name": "rotary-platform-v2-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test --config=playwright.config.mjs",
    "test:role-shells-off": "E2E_ROLE_SHELL_ROLLBACK=disabled playwright test tests/role-shells-off.e2e.mjs --config=playwright.config.mjs",
    "test:role-shells-force": "E2E_ROLE_SHELL_ROLLBACK=force playwright test tests/role-shells-force-legacy.e2e.mjs --config=playwright.config.mjs",
    "test:member-home-off": "E2E_MEMBER_HOME_ROLLBACK=disabled playwright test tests/member-home-off.e2e.mjs --config=playwright.config.mjs",
    "test:member-home-force": "E2E_MEMBER_HOME_ROLLBACK=force playwright test tests/member-home-force-legacy.e2e.mjs --config=playwright.config.mjs",
    "test:staging": "playwright test tests/staging-member-acceptance.e2e.mjs --config=playwright.config.mjs --project=desktop-chromium",
    "install:chromium": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
